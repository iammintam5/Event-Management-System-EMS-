{
  "name": "event-management-system",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "pnpm --parallel --filter @ems/web --filter @ems/api dev",
    "build": "pnpm --filter @ems/api db:generate && pnpm -r build",
    "typecheck": "pnpm --filter @ems/api db:generate && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @ems/api test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:validate": "pnpm --filter @ems/api db:validate",
    "db:generate": "pnpm --filter @ems/api db:generate",
    "db:migrate": "pnpm --filter @ems/api db:migrate",
    "db:deploy": "pnpm --filter @ems/api db:deploy",
    "db:studio": "pnpm --filter @ems/api db:studio",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
