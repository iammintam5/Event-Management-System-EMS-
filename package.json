{
  "name": "event-management-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "build:packages": "pnpm --fail-if-no-match --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./packages/*\" --filter \"./apps/*\" --filter \"./services/*\" dev",
    "dev:web": "pnpm --filter @ems/web dev",
    "dev:gateway": "pnpm build:packages && pnpm --filter @ems/gateway dev",
    "dev:services": "pnpm build:packages && pnpm --parallel --filter \"./services/*\" dev",
    "dev:identity": "pnpm build:packages && pnpm --filter @ems/identity-service dev",
    "dev:event": "pnpm build:packages && pnpm --filter @ems/event-service dev",
    "dev:registration": "pnpm build:packages && pnpm --filter @ems/registration-service dev",
    "dev:operations": "pnpm build:packages && pnpm --filter @ems/operations-service dev",
    "dev:reporting": "pnpm build:packages && pnpm --filter @ems/reporting-service dev",
    "build": "pnpm db:generate && pnpm -r build",
    "typecheck": "pnpm db:generate && pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:validate": "pnpm --fail-if-no-match --filter \"./services/*\" --workspace-concurrency=1 db:validate",
    "db:generate": "pnpm --fail-if-no-match --filter \"./services/*\" --workspace-concurrency=1 db:generate",
    "db:check": "pnpm --fail-if-no-match --filter \"./services/*\" --workspace-concurrency=1 db:check",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.1",
    "@jest/globals": "^30.2.0"
  }
}
